                    local colorDrag = false
                    local colorInput = nil
                    local function SetColor(i)
                        local s = Canvas.AbsoluteSize
                        local p = Canvas.AbsolutePosition
                        if s.X <= 0 or s.Y <= 0 then return end
                        local x = math.clamp((i.Position.X - p.X) / s.X, 0, 1)
                        local y = math.clamp((i.Position.Y - p.Y) / s.Y, 0, 1)
                        Circle.Position = UDim2.fromScale(x, y)
                        color = Color3.fromHSV(x, 1 - y, 1)
                        CB.BackgroundColor3 = color
                        Circle.BackgroundColor3 = color
                        pcall(colorcb, color)
                    end

                    Canvas.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1
                            or i.UserInputType == Enum.UserInputType.Touch then
                            colorDrag = true
                            colorInput = i
                            SetColor(i)
                        end
                    end)
                    ControlConnect(UIS.InputChanged, function(i)
                        if colorDrag and colorInput
                            and ((colorInput.UserInputType == Enum.UserInputType.MouseButton1
                                and i.UserInputType == Enum.UserInputType.MouseMovement)
                                or i == colorInput) then
                            SetColor(i)
                        end
                    end)
                    ControlConnect(UIS.InputEnded, function(i)
                        if i == colorInput then
                            colorDrag = false
                            colorInput = nil
                        end
                    end)

                    RegisterConfig(
                        name .. "_Color",
                        "Color3",
                        function() return color end,
                        function(v)
                            local cc = TableToColor(v)
                            if cc then
                                color = cc
                                CB.BackgroundColor3 = color
                                Circle.BackgroundColor3 = color
                                pcall(colorcb, color)
                            end
                        end
                    )
                end

                --// TOUCH SHORTCUT OR KEYBIND CAPTURE
                if UIS.TouchEnabled and not keybindPicker then
                    local ShortcutButton = nil
                    local ShortcutDragConn = nil
                    local function RemoveShortcut()
                        if ShortcutDragConn then
                            ShortcutDragConn:Disconnect()
                            ShortcutDragConn = nil
                        end
                        if ShortcutButton then
                            ShortcutButton:Destroy()
                            ShortcutButton = nil
                        end
                        Bind:SetAttribute("Shown", false)
                        Bind.Text = "Show"
                    end
                    Bind.MouseButton1Click:Connect(function()
                        if Bind:GetAttribute("Shown") then
                            RemoveShortcut()
                            return
                        end
                        Bind:SetAttribute("Shown", true)
                        Bind.Text = "Hide"
                        local SB = Instance.new("TextButton")
                        ShortcutButton = SB
                        H.Destroying:Once(function()
                            if ShortcutButton == SB then RemoveShortcut() end
                        end)
                        SB.Parent = Gui
                        SB.Name = (name or "Toggle") .. "_Shortcut"
                        SB.Size = UDim2.fromOffset(78, 30)
                        SB.Position = UDim2.new(1, -90, 0.35, 0)
                        SB.Font = Enum.Font.GothamBold
                        SB.Text = name or "Toggle"
                        SB.TextSize = 10
                        SB.TextWrapped = true
                        SB.BackgroundColor3 = active and Theme.AccentDim or Theme.WindowBg
                        SB.TextColor3 = Theme.TextPrimary
                        SB.ZIndex = 250
                        SB.Active = true
                        SB.AutoButtonColor = false
                        ApplyCorner(SB, 6)
                        ApplyStroke(SB, Theme.Border, 0.15, 1)

                        local sDrag, sMoved, sInput, sStart, sPos = false, false, nil, nil, nil
                        SB.InputBegan:Connect(function(i)
                            if i.UserInputType == Enum.UserInputType.MouseButton1
                                or i.UserInputType == Enum.UserInputType.Touch then
                                sDrag = true
                                sMoved = false
                                sStart = i.Position
                                sPos = SB.Position
                                OnRelease(i, function() sDrag = false end)
                            end
                        end)
                        SB.InputChanged:Connect(function(i)
                            if i.UserInputType == Enum.UserInputType.MouseMovement
                                or i.UserInputType == Enum.UserInputType.Touch then
                                sInput = i
                            end
                        end)
                        ShortcutDragConn = ControlConnect(UIS.InputChanged, function(i)
                            if i == sInput and sDrag and ShortcutButton == SB then
                                local d = i.Position - sStart
                                if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then sMoved = true end
                                SB.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
                            end
                        end)
                        local shortcutPress, shortcutInput = false, nil
                        SB.InputBegan:Connect(function(i)
                            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                                and i.UserInputType ~= Enum.UserInputType.Touch then
                                return
                            end
                            if sMoved or ShortcutButton ~= SB then return end
                            shortcutPress = true
                            shortcutInput = i
                            if keybindRequiresToggle and not keybindMode and not armed then return end
                            if keybindMode then
                                if armed and toggleMode == "Hold" then SetActive(true, true) end
                            elseif toggleMode == "Hold" then
                                SetActive(true, true)
                            end
                        end)
                        ControlConnect(UIS.InputEnded, function(i)
                            if i.UserInputType ~= Enum.UserInputType.MouseButton1
                                and i.UserInputType ~= Enum.UserInputType.Touch then
                                return
                            end
                            if not shortcutPress or i ~= shortcutInput or ShortcutButton ~= SB then return end
                            shortcutPress = false
                            if sMoved and toggleMode ~= "Hold" then return end
                            if keybindRequiresToggle and not keybindMode and not armed then return end
                            if keybindMode then
                                if armed then
                                    if toggleMode == "Hold" then
                                        SetActive(false, true)
                                    else
                                        SetActive(not active, true)
                                    end
                                end
                            elseif toggleMode == "Hold" then
                                SetActive(false, true)
                            else
                                active = not active
                                UpdateNormal()
                            end
                            SB.BackgroundColor3 = active and Theme.AccentDim or Theme.WindowBg
                        end)
                    end)
                elseif hasBind then
                    local listening = false
                    Bind.MouseButton1Click:Connect(function()
                        Bind.Text = "..."
                        listening = true
                        BindCapture = Bind
                    end)
                    ControlConnect(UIS.InputBegan, function(i, gp)
                        if BindCapture and BindCapture ~= Bind then return end
                        if listening and BindCapture == Bind then
                            if i.UserInputType == Enum.UserInputType.Keyboard
                                or i.UserInputType == Enum.UserInputType.MouseButton1
                                or i.UserInputType == Enum.UserInputType.MouseButton2
                                or i.UserInputType == Enum.UserInputType.MouseButton3 then
                                if toggleMode == "Hold" and active then SetActive(false, true) end
                                if i.KeyCode == Enum.KeyCode.Escape or i.KeyCode == Enum.KeyCode.Backspace then
                                    currentBind = nil
                                    Bind.Text = "None"
                                elseif i.UserInputType == Enum.UserInputType.Keyboard then
                                    currentBind = i.KeyCode
                                    Bind.Text = i.KeyCode.Name
                                else
                                    currentBind = i.UserInputType
                                    Bind.Text = i.UserInputType.Name:gsub("MouseButton", "MB")
                                end
                                UpdateRightRow()
                                listening = false
                                BindCapture = nil
                            end
                        elseif not gp and not UIS:GetFocusedTextBox() and currentBind then
                            local match = (currentBind.EnumType == Enum.KeyCode and i.KeyCode == currentBind)
                                or (currentBind.EnumType == Enum.UserInputType and i.UserInputType == currentBind)
                            if match then
                                if keybindRequiresToggle and not keybindMode and not armed then return end
                                if keybindMode then
                                    if armed then
                                        if toggleMode == "Hold" then
                                            SetActive(true, true)
                                        else
                                            SetActive(not active, true)
                                        end
                                    end
                                elseif toggleMode == "Hold" then
                                    SetActive(true, true)
                                else
                                    active = not active
                                    UpdateNormal()
                                end
                            end
                        end
                    end)
                end

                if hasBind and (not UIS.TouchEnabled or keybindPicker) then
                    ControlConnect(UIS.InputEnded, function(i)
                        if toggleMode ~= "Hold" or not currentBind then return end
                        local match = (currentBind.EnumType == Enum.KeyCode and i.KeyCode == currentBind)
                            or (currentBind.EnumType == Enum.UserInputType and i.UserInputType == currentBind)
                        if match then
                            if keybindMode then
                                if armed then SetActive(false, true) end
                            else
                                SetActive(false, true)
                            end
                        end
                    end)
                end

                if ModeButton then ModeButton.Text = toggleMode end

                if keybindMode then
                    active = false
                    pcall(callback, false)
                else
                    active = default
                    pcall(callback, active)
                end
                UpdateRightRow()
                UpdateSwitchVisual()

                RegisterElement(H, name, "Toggle")
                RegisterConfig(
                    name,
                    "Toggle",
                    function()
                        return {
                            Enabled = armed,
                            Active = active,
                            Keybind = SerializeBind(currentBind) or false,
                            KeybindMode = keybindMode,
                            KeybindRequiresToggle = keybindRequiresToggle,
                            ToggleMode = toggleMode,
                            HoldToggle = holdToggle
                        }
                    end,
                    function(v)
                        if type(v) == "boolean" then
                            armed = v
                            if keybindMode or keybindRequiresToggle then
                                active = (keybindRequiresToggle and not keybindMode) and v or false
                            else
                                active = v
                            end
                        elseif type(v) == "table" then
                            armed = v.Enabled == true
                            if holdToggle and (v.ToggleMode == "Hold" or v.ToggleMode == "Toggle") then
                                toggleMode = v.ToggleMode
                                if ModeButton then ModeButton.Text = toggleMode end
                                if keybindMode and toggleMode == "Hold" and active then
                                    active = false
                                    pcall(callback, false)
                                end
                            end
                            if v.Keybind == false then
                                currentBind = nil
                                if not UIS.TouchEnabled or keybindPicker then Bind.Text = "None" end
                            elseif v.Keybind ~= nil then
                                local newBind = DeserializeBind(v.Keybind)
                                if newBind then
                                    currentBind = newBind
                                    if not UIS.TouchEnabled then
                                        Bind.Text = currentBind.Name:gsub("MouseButton", "MB")
                                    end
                                end
                            end
                            if keybindMode or keybindRequiresToggle then
                                active = v.Active == true and armed
                            else
                                active = v.Active ~= nil and (v.Active == true) or armed
                            end
                        end
                        pcall(callback, active)
                        UpdateRightRow()
                        UpdateSwitchVisual()
                    end
                )
                task.defer(UpdateCanvas)
                return H
            end

            --// SLIDER
            function target:addSlider(name, a, b, c, d)
                EnsureDirectVisible()
                local min, max, value, callback, rounding
                local function finite(v, fallback)
                    v = tonumber(v)
                    if not v or v ~= v or math.abs(v) == math.huge then return fallback end
                    return v
                end

                if type(a) == "table" then
                    local o = a
                    name = o.Text or name
                    min = finite(o.Min, 0)
                    max = finite(o.Max, 100)
                    value = tonumber(o.Default)
                    rounding = math.clamp(math.floor(finite(o.Rounding, 0)), 0, 10)
                    callback = o.Callback or function() end
                else
                    min = finite(a, 0)
                    max = finite(b, 100)
                    callback = c or function() end
                    value = tonumber(d)
                    rounding = 0
                end

                if max < min then min, max = max, min end
                local step = 10 ^ -rounding
                local function roundValue(v)
                    v = math.clamp(finite(v, min), min, max)
                    if rounding > 0 then
                        v = math.clamp(math.round(v / step) * step, min, max)
                    else
                        v = math.clamp(math.floor(v + 0.5), min, max)
                    end
                    return v
                end
                value = roundValue(value or min)

                local function formatValue(v)
                    if rounding <= 0 then return tostring(math.floor(v + 0.5)) end
                    local text = string.format("%." .. rounding .. "f", v)
                    text = text:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
                    return text
                end

                local H = Instance.new("Frame")
                local T = Instance.new("TextLabel")
                local B = Instance.new("TextButton")
                local Trail = Instance.new("Frame")
                local Knob = Instance.new("Frame")
                local Num = Instance.new("TextBox")

                local function ControlConnect(signal, cb)
                    return Connect(signal, cb, H)
                end

                H.Parent = containerParent
                H.BackgroundColor3 = Theme.ControlBg
                H.BackgroundTransparency = Theme.ControlAlpha
                H.BorderSizePixel = 0
                SetRowHeight(H, 38, isInsideGroup)
                ApplyCorner(H, 5)
                ApplyStroke(H, Theme.BorderSubtle, 0.2, 1)

                T.Parent = H
                T.BackgroundTransparency = 1
                T.Position = UDim2.fromOffset(8, 3)
                T.Size = UDim2.new(1, -56, 0, 12)
                T.TextTruncate = Enum.TextTruncate.AtEnd
                T.Font = Enum.Font.GothamMedium
                T.Text = name or ""
                T.TextColor3 = Theme.TextPrimary
                T.TextSize = 11
                T.TextXAlignment = Enum.TextXAlignment.Left

                Num.Parent = H
                Num.BackgroundTransparency = 1
                Num.Position = UDim2.new(1, -48, 0, 3)
                Num.Size = UDim2.fromOffset(40, 12)
                Num.Font = Enum.Font.Code
                Num.Text = formatValue(value)
                Num.TextColor3 = Theme.Accent
                Num.TextSize = 11
                Num.TextEditable = true
                Num.ZIndex = 5
                Num.TextXAlignment = Enum.TextXAlignment.Right
                Num.ClearTextOnFocus = false

                B.Parent = H
                B.BackgroundColor3 = Theme.InputBg
                B.BorderSizePixel = 0
                B.Position = UDim2.fromOffset(8, 20)
                B.Size = UDim2.new(1, -16, 0, 5)
                B.Text = ""
                B.AutoButtonColor = false
                B.Active = true
                ApplyCorner(B, 3)

                Trail.Parent = B
                Trail.BackgroundColor3 = Theme.Accent
                Trail.BorderSizePixel = 0
                Trail.Size = UDim2.new(0, 1, 1, 0)
                Trail.ZIndex = 2
                ApplyCorner(Trail, 3)

                Knob.Parent = B
                Knob.BackgroundColor3 = Theme.TextPrimary
                Knob.BorderSizePixel = 0
                Knob.Size = UDim2.fromOffset(10, 10)
                Knob.AnchorPoint = Vector2.new(0.5, 0.5)
                Knob.Position = UDim2.new(0, 0, 0.5, 0)
                Knob.ZIndex = 4
                ApplyCorner(Knob, 5)
                ApplyStroke(Knob, Theme.InputBg, 0.2, 1)

                local function Set(v, callCallback)
                    value = roundValue(v)
                    Num.Text = formatValue(value)
                    local p = max == min and 0 or math.clamp((value - min) / (max - min), 0, 1)
                    Trail.Size = UDim2.new(p, 0, 1, 0)
                    Knob.Position = UDim2.new(p, 0, 0.5, 0)
                    if callCallback ~= false then pcall(callback, value) end
                end

                local moving = false
                local moveInput = nil
                local function UpdateFromX(x)
                    if B.AbsoluteSize.X <= 0 then return end
                    local p = math.clamp((x - B.AbsolutePosition.X) / B.AbsoluteSize.X, 0, 1)
                    Set(min + (max - min) * p, true)
                end

                B.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1
                        or i.UserInputType == Enum.UserInputType.Touch then
                        moving = true
                        moveInput = i
                        UpdateFromX(i.Position.X)
                    end
                end)
                ControlConnect(UIS.InputChanged, function(i)
                    if not moving or not moveInput then return end
                    if (moveInput.UserInputType == Enum.UserInputType.MouseButton1
                        and i.UserInputType == Enum.UserInputType.MouseMovement)
                        or i == moveInput then
                        UpdateFromX(i.Position.X)
                    end
                end)
                ControlConnect(UIS.InputEnded, function(i)
                    if i == moveInput then
                        moving = false
                        moveInput = nil
                    end
                end)

                Num.FocusLost:Connect(function()
                    local typed = tonumber((tostring(Num.Text):gsub("%s+", "")))
                    if typed == nil then
                        Num.Text = formatValue(value)
                        return
                    end
                    Set(typed, true)
                end)
                Num.Focused:Connect(function()
                    task.defer(function() Num.CursorPosition = #Num.Text + 1 end)
                end)

                Set(value, false)
                RegisterElement(H, name, "Slider")
                RegisterConfig(
                    name,
                    "Slider",
                    function() return value end,
                    function(v) Set(v, true) end
                )
                task.defer(UpdateCanvas)
                return H
            end

            --// TEXTBOX
            function target:addTextBox(name, default, callback)
                EnsureDirectVisible()
                local o = type(default) == "table" and default or nil
                if o then
                    name = o.Text or name
                    default = o.Default or ""
                    callback = o.Callback
                end
                callback = callback or function() end
                local hasTitle = tostring(name or "") ~= ""

                local H = Instance.new("Frame")
                local T = Instance.new("TextLabel")
                local B = Instance.new("TextBox")

                H.Parent = containerParent
                H.BackgroundColor3 = Theme.ControlBg
                H.BackgroundTransparency = Theme.ControlAlpha
                H.BorderSizePixel = 0
                SetRowHeight(H, 34, isInsideGroup)
                ApplyCorner(H, 5)
                ApplyStroke(H, Theme.BorderSubtle, 0.2, 1)

                T.Parent = H
                T.BackgroundTransparency = 1
