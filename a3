    local function ResolvePluginResult(result)
        local current = result
        for _ = 1, 8 do
            if type(current) == "table" then
                if type(current.Tabs) == "table" then return current end
                if type(current.Plugin) == "table" then
                    current = current.Plugin
                elseif type(current.Data) == "table" then
                    current = current.Data
                elseif type(current.Module) == "table" then
                    current = current.Module
                else
                    return nil, "Invalid plugin table"
                end
            elseif type(current) == "function" then
                local ok, nextResult = pcall(current)
                if not ok then return nil, tostring(nextResult) end
                current = nextResult
            else
                return nil, "Returned " .. type(current)
            end
        end
        return nil, "Wrapper depth exceeded"
    end

    local function ExecutePluginSource(source, fileName)
        if type(loadstring) ~= "function" then return nil, "loadstring unavailable" end
        local ok, chunk, compileError = pcall(function()
            return loadstring(source, "@" .. tostring(fileName))
        end)
        if not ok or type(chunk) ~= "function" then
            return nil, tostring(compileError or chunk)
        end
        local okRun, result = pcall(chunk)
        if not okRun then return nil, tostring(result) end
        return ResolvePluginResult(result)
    end

    local function LoadPlugin(path)
        if type(path) ~= "string" or path == "" then
            if PluginStatus then
                PluginStatus.Text = "Select a plugin first"
                PluginStatus.TextColor3 = Theme.Bad
            end
            return false
        end
        local fileKey = tostring(path):gsub("\\", "/"):gsub("/+", "/"):gsub("^%./", "")
        if LoadedPlugins[fileKey] or PluginLoading[fileKey] then
            if PluginStatus then
                PluginStatus.Text = "Already loaded: " .. PluginFileName(fileKey)
                PluginStatus.TextColor3 = Theme.Warn
            end
            return false
        end
        if not FileExists(fileKey) or type(readfile) ~= "function" or type(loadstring) ~= "function" then
            if PluginStatus then
                PluginStatus.Text = "Plugin unavailable"
                PluginStatus.TextColor3 = Theme.Bad
            end
            return false
        end
        local okRead, source = pcall(function() return readfile(fileKey) end)
        if not okRead or type(source) ~= "string" or source == "" then
            if PluginStatus then
                PluginStatus.Text = "Failed to read plugin"
                PluginStatus.TextColor3 = Theme.Bad
            end
            return false
        end
        PluginLoading[fileKey] = true
        local executeOk, plugin, err = pcall(ExecutePluginSource, source, PluginFileName(fileKey))
        PluginLoading[fileKey] = nil
        if not executeOk then
            err = plugin
            plugin = nil
        end
        if not plugin or type(plugin.Tabs) ~= "table" then
            if PluginStatus then
                PluginStatus.Text = "Error: " .. tostring(err or "No Tabs")
                PluginStatus.TextColor3 = Theme.Bad
            end
            return false
        end
        local pluginName = tostring(plugin.Name or PluginFileName(fileKey))
        local pluginInfo = {
            Name = pluginName,
            File = fileKey,
            Plugin = plugin,
            Tabs = {},
            Entries = {}
        }
        LoadedPlugins[fileKey] = pluginInfo
        local previousPlugin = CurrentPlugin
        CurrentPlugin = pluginInfo
        local createdTabs = 0
        for _, tabInfo in ipairs(plugin.Tabs) do
            if type(tabInfo) == "table" and type(tabInfo.Name) == "string" then
                local requestedName = tostring(tabInfo.Name)
                if requestedName:lower() ~= "config" and requestedName:lower() ~= "home"
                    and not PageTabs[requestedName] then
                    local pageOk, page = pcall(function()
                        return PageYep:addPage(
                            requestedName,
                            tabInfo.ScrollSize or 6,
                            false,
                            tabInfo.ElementSpacing or 6
                        )
                    end)
                    if pageOk and page then
                        table.insert(pluginInfo.Tabs, page)
                        createdTabs += 1
                        if type(tabInfo.Elements) == "function" then
                            pcall(tabInfo.Elements, page, plugin)
                        end
                    end
                end
            end
        end
        CurrentPlugin = previousPlugin
        UpdateWindowLayout()
        if createdTabs == 0 then
            LoadedPlugins[fileKey] = nil
            if PluginStatus then
                PluginStatus.Text = "Plugin created no tabs"
                PluginStatus.TextColor3 = Theme.Bad
            end
            return false
        end
        if LoadedConfigData and type(LoadedConfigData.Plugins) == "table" then
            local savedPlugin = LoadedConfigData.Plugins[fileKey] or LoadedConfigData.Plugins[pluginName]
            if type(savedPlugin) == "table" and type(savedPlugin.Values) == "table" then
                for _, entry in ipairs(PluginConfigEntries) do
                    if entry.Plugin == pluginInfo then
                        local saved = savedPlugin.Values[entry.Key] or savedPlugin.Values[entry.Name]
                        if type(saved) == "table"
                            and (saved.Type == nil or saved.Type == entry.Type)
                            and saved.Value ~= nil then
                            pcall(entry.Set, Clone(saved.Value))
                        end
                    end
                end
            end
        end
        if pluginInfo.Tabs[1] then
            InitialHomeLocked = false
            pluginInfo.Tabs[1].__Show()
        end
        if PluginStatus then
            PluginStatus.Text = "Loaded: " .. pluginName .. " (" .. createdTabs .. " tab)"
            PluginStatus.TextColor3 = Theme.Accent
        end
        return true
    end

    CfgRight:addButton("Refresh Plugins", RefreshPluginDropdown)
    CfgRight:addButton("Load Plugin", function()
        local selected = PluginDropdown and PluginDropdown.Get()
        LoadPlugin(selected and tostring(selected) or "")
    end)

    local AppearanceBox = ConfigPage:addGroupBox("Appearance", "Full")
    ThemeDropdown = AppearanceBox:addDropdown(
        "Color Theme",
        { "Midnight", "Graphite", "Violet", "Ocean", "Light" },
        6,
        function(value)
            if not value then return end
            CurrentThemeName = tostring(value)
            ApplyTheme(CurrentThemeName)
        end
    )
    if ThemeDropdown and ThemeDropdown.Set then
        pcall(function() ThemeDropdown.Set(CurrentThemeName) end)
    end

    local _, accentInput = AppearanceBox:addTextBox(
        "Accent Hex",
        CurrentAccentHex ~= "" and CurrentAccentHex or "#A697FF",
        function(value)
            local color = ParseHexColor(value)
            if not color then
                SetStatus("Accent must be a 6-digit hex value", false)
                return
            end
            CurrentAccentHex = "#" .. tostring(value):gsub("^#", "")
            ApplyTheme(CurrentThemeName, color)
            SetStatus("Accent color applied", true)
        end
    )
    AccentHexBox = accentInput
    AppearanceBox:addButton("Reset Accent", function()
        CurrentAccentHex = ""
        local preset = ThemePresets[CurrentThemeName] or ThemePresets.Midnight
        if AccentHexBox then AccentHexBox.Text = ColorToHex(preset.Accent) end
        ApplyTheme(CurrentThemeName, nil)
        SetStatus("Theme accent restored", true)
    end)

    local _, backgroundInput = AppearanceBox:addTextBox(
        "Image URL",
        CurrentBackgroundUrl,
        function(value)
            CurrentBackgroundUrl = tostring(value or "")
        end
    )
    BackgroundUrlBox = backgroundInput

    AppearanceBox:addButton("Apply Background", function()
        local url = BackgroundUrlBox and BackgroundUrlBox.Text or CurrentBackgroundUrl
        local ok, message = SetBackgroundImage(url)
        SetStatus(message, ok)
        if ok then PersistSettings() end
    end)
    AppearanceBox:addButton("Remove Background", function()
        ClearBackgroundImage()
        if BackgroundUrlBox then BackgroundUrlBox.Text = "" end
        PersistSettings()
        SetStatus("Background removed", true)
    end)

    --// GLOBAL RESET
    local function ResetAll()
        for _, entry in ipairs(ResetEntries) do
            local resetValue = Clone(entry.Default)
            if entry.Type == "Toggle" and type(resetValue) == "table" then
                resetValue.Enabled = false
                resetValue.Active = false
            end
            if resetValue ~= nil then
                pcall(entry.Set, resetValue)
            elseif entry.Type == "Dropdown" then
                pcall(entry.Set, nil)
            end
        end
        AutoLoad = false
        if AutoLoadSetter then pcall(AutoLoadSetter, false) end
        LoadedConfigData = nil
        PerformanceMode = false
        ShowKeybinds = false
        UpdateTogglePanel()
        UIScaleValue = DefaultUIScale
        Scale.Scale = UIScaleValue
        CurrentConfig = "Default"
        if ConfigNameBox then ConfigNameBox.Text = "Default" end
        CurrentThemeName = "Midnight"
        CurrentAccentHex = ""
        ApplyTheme(CurrentThemeName, nil, false)
        if ThemeDropdown and ThemeDropdown.Set then pcall(function() ThemeDropdown.Set(CurrentThemeName) end) end
        if AccentHexBox then AccentHexBox.Text = "#A697FF" end
        ClearBackgroundImage()
        if BackgroundUrlBox then BackgroundUrlBox.Text = "" end
        SearchBox.Text = ""
        ClearHighlight()
        pcall(function()
            writefile(
                ConfigFolder .. "/settings.json",
                HttpService:JSONEncode({
                    Config = "Default", AutoLoad = false, Theme = "Midnight",
                    AccentHex = "", BackgroundUrl = "",
                })
            )
        end)
        UpdateTogglePanel()
        UpdateWindowLayout()
    end

    ResetButton.MouseButton1Click:Connect(ResetAll)

    --// STARTUP AUTOLOAD
    task.spawn(function()
        if not SetupFolder() then return end
        local settingsPath = ConfigFolder .. "/settings.json"
        if FileExists(settingsPath) then
            local ok, contents = pcall(function() return readfile(settingsPath) end)
            if ok and contents then
                local decodedOk, data = pcall(function() return HttpService:JSONDecode(contents) end)
                if decodedOk and type(data) == "table" then
                    if type(data.Config) == "string" and data.Config ~= "" then
                        CurrentConfig = CleanName(data.Config)
                    end
                    AutoLoad = data.AutoLoad == true
                    if type(data.Theme) == "string" and ThemePresets[data.Theme] then
                        CurrentThemeName = data.Theme
                    end
                    if type(data.AccentHex) == "string" then
                        CurrentAccentHex = data.AccentHex
                    end
                    if type(data.BackgroundUrl) == "string" then
                        CurrentBackgroundUrl = data.BackgroundUrl
                    end
                    if ConfigNameBox then ConfigNameBox.Text = CurrentConfig end
                    if ThemeDropdown and ThemeDropdown.Set then
                        pcall(function() ThemeDropdown.Set(CurrentThemeName) end)
                    end
                    if AccentHexBox and CurrentAccentHex ~= "" then
                        AccentHexBox.Text = CurrentAccentHex
                    end
                    if BackgroundUrlBox then BackgroundUrlBox.Text = CurrentBackgroundUrl end
                    ApplyTheme(CurrentThemeName, nil, false)
                end
            end
        end
        if AutoLoadSetter then pcall(AutoLoadSetter, AutoLoad) end
        SettingsReady = true
        task.wait(0.15)
        if not alive then return end
        if ConfigDropdown then ConfigDropdown.Refresh(GetConfigFiles()) end
        if PluginDropdown then RefreshPluginDropdown() end
        if CurrentBackgroundUrl ~= "" then
            task.spawn(function()
                local ok, message = SetBackgroundImage(CurrentBackgroundUrl)
                if not ok then SetStatus(message, false) end
            end)
        end
        if AutoLoad then
            task.wait(0.25)
            if not alive then return end
            LoadConfig(CurrentConfig)
        end
    end)

    task.defer(function()
        task.wait(0.05)
        if not alive then return end
        UpdateTogglePanel()
        UpdateWindowLayout()
        HomePage.__Show()
    end)

    PageYep.AddPage = PageYep.addPage
    PageYep.HomePage = HomePage
    PageYep.ConfigPage = ConfigPage
    PageYep.Destroy = function() Gui:Destroy() end
    PageYep.SaveConfig = function(_, name) return SaveConfig(name or CurrentConfig) end
    PageYep.LoadConfig = function(_, name) return LoadConfig(name or CurrentConfig) end
    PageYep.Reset = ResetAll
    PageYep.LoadPlugin = function(_, path) return LoadPlugin(path) end
    return PageYep
end

return Library
