    local function QueueCanvasUpdate(fn)
        if not alive then return end
        if not PerformanceMode then
            task.defer(function() if alive then fn() end end)
            return
        end
        PendingCanvasUpdates[fn] = true
        if UIRefreshQueued then return end
        UIRefreshQueued = true
        task.delay(0.06, function()
            UIRefreshQueued = false
            local pending = PendingCanvasUpdates
            PendingCanvasUpdates = {}
            if not alive then return end
            for callback in pairs(pending) do pcall(callback) end
        end)
    end

    -- Hover smoothing loop (lightweight & paused when hidden or PerformanceMode)
    do
        local hoverPaused = false
        Connect(RunService.RenderStepped, function(dt)
            if not Frame.Visible or PerformanceMode then
                if not hoverPaused then
                    hoverPaused = true
                    for owner, state in pairs(HoverTargets) do
                        state.Inside = false
                        state.Amount = 0
                        if owner.Parent then
                            if state.NormalBg then owner.BackgroundColor3 = state.NormalBg end
                            if state.Stroke and state.Stroke.Parent then
                                state.Stroke.Color = Theme.BorderSubtle
                            end
                        end
                    end
                end
                return
            end
            hoverPaused = false
            dt = math.min(math.max(dt, 0), 0.05)
            local smoothing = 1 - math.exp(-dt * 16)
            local blocked = dragging or Frame:GetAttribute("Resizing")
            for owner, state in pairs(HoverTargets) do
                if owner.Parent then
                    local goal = (state.Inside and not blocked) and 1 or 0
                    if math.abs(goal - state.Amount) > 0.005 then
                        state.Amount += (goal - state.Amount) * smoothing
                        if state.NormalBg and state.HoverBg then
                            owner.BackgroundColor3 = state.NormalBg:Lerp(state.HoverBg, state.Amount)
                        end
                        if state.Stroke and state.Stroke.Parent then
                            state.Stroke.Color = Theme.BorderSubtle:Lerp(Theme.BorderHover, state.Amount)
                        end
                    end
                end
            end
        end, Frame)
    end

