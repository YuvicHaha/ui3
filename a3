    local function ParseHexColor(value)
        local hex = tostring(value or ""):gsub("^#", "")
        if #hex ~= 6 or hex:find("[^%x]") then return nil end
        return Color3.fromRGB(
            tonumber(hex:sub(1, 2), 16),
            tonumber(hex:sub(3, 4), 16),
            tonumber(hex:sub(5, 6), 16)
        )
    end

    local function ColorToHex(color)
        return string.format(
            "#%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5)
        )
    end

    local function BuildThemePalette(name, customAccent)
        local preset = ThemePresets[name] or ThemePresets.Midnight
        local palette = {}
        for key, value in pairs(Theme) do palette[key] = value end
        for key, value in pairs(preset) do palette[key] = value end
        local accent = customAccent or preset.Accent
        palette.Accent = accent
        palette.AccentDim = accent:Lerp(preset.WindowBg, 0.58)
        palette.AccentMuted = accent:Lerp(preset.GroupBg, 0.88)
        return palette
    end

    local function ApplyTheme(name, customAccent, persist)
        name = ThemePresets[name] and name or "Midnight"
        local accent = customAccent or ParseHexColor(CurrentAccentHex)
        local palette = BuildThemePalette(name, accent)
        local previous = {}
        for key, value in pairs(Theme) do previous[key] = value end

        local function RemapColor(value)
            if typeof(value) ~= "Color3" then return value end
            for key, oldColor in pairs(previous) do
                if typeof(oldColor) == "Color3" and value == oldColor
                    and typeof(palette[key]) == "Color3" then
                    return palette[key]
                end
            end
            return value
        end

        for key, value in pairs(palette) do Theme[key] = value end
        for _, object in ipairs(Gui:GetDescendants()) do
            for _, property in ipairs({ "BackgroundColor3", "TextColor3", "ImageColor3", "ScrollBarImageColor3" }) do
                local ok, current = pcall(function() return object[property] end)
                if ok and typeof(current) == "Color3" then
                    local updated = RemapColor(current)
                    if updated ~= current then pcall(function() object[property] = updated end) end
                end
            end
            if object:IsA("UIStroke") then
                object.Color = RemapColor(object.Color)
            end
        end
        for _, state in pairs(HoverTargets) do
            state.NormalBg = state.NormalBg and RemapColor(state.NormalBg) or state.NormalBg
            state.HoverBg = state.HoverBg and RemapColor(state.HoverBg) or state.HoverBg
        end
        CurrentThemeName = name
        local accentHex = ColorToHex(Theme.Accent)
        if AccentHexBox and CurrentAccentHex == "" then
            AccentHexBox.Text = accentHex
        end
        Title.Text = 'Skido<font color="' .. accentHex .. '">.hvh</font>'
        Float.Text = 'Skido<font color="' .. accentHex .. '">.hvh</font>'
        for pageName, tabData in pairs(PageTabs) do
            local page = Folder:FindFirstChild(pageName)
            if page and page.Visible then
                SetActiveTabVisual(pageName)
                break
            end
        end
