        local state = {
            Stroke = stroke or owner:FindFirstChildOfClass("UIStroke"),
            NormalBg = normalBg,
            HoverBg = hoverBg,
            Inside = false,
            Amount = 0,
        }
        HoverTargets[owner] = state
        Connect(owner.MouseEnter, function() state.Inside = true end, owner)
        Connect(owner.MouseLeave, function() state.Inside = false end, owner)
        owner.Destroying:Once(function() HoverTargets[owner] = nil end)
