    --// EDGE / CORNER RESIZE
    Frame:SetAttribute("Resizing", false)
    do
        local pointer = nil
        local edge = nil
        local startPointer = nil
        local startSize = nil
        local startPosition = nil
        local startScale = 1

        local function StopResize()
            pointer = nil
            edge = nil
            Frame:SetAttribute("Resizing", false)
        end

        local function MakeHandle(name, anchor, position, size, zindex)
            local Handle = Instance.new("TextButton")
            Handle.Name = name
            Handle.BackgroundTransparency = 1
            Handle.BorderSizePixel = 0
            Handle.AnchorPoint = anchor
            Handle.Position = position
            Handle.Size = size
            Handle.Text = ""
            Handle.AutoButtonColor = false
            Handle.Selectable = false
            Handle.ZIndex = zindex
            Handle.Parent = Frame
            Connect(Handle.InputBegan, function(i)
                if pointer then return end
                if i.UserInputType ~= Enum.UserInputType.MouseButton1
                    and i.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                dragging = false
                pointer = i
                edge = name
                startPointer = i.Position
                startScale = math.max(Scale.Scale, 0.01)
                startSize = Vector2.new(Frame.Size.X.Offset, Frame.Size.Y.Offset)
                startPosition = Frame.Position
                Frame:SetAttribute("Resizing", true)
                OnRelease(i, function() if pointer == i then StopResize() end end)
            end, Handle)
        end

        MakeHandle("ResizeLeft", Vector2.new(0, 0), UDim2.new(0, 0, 0, 14), UDim2.new(0, 5, 1, -28), 99)
        MakeHandle("ResizeRight", Vector2.new(1, 0), UDim2.new(1, 0, 0, 14), UDim2.new(0, 5, 1, -28), 99)
        MakeHandle("ResizeTop", Vector2.new(0, 0), UDim2.new(0, 14, 0, 0), UDim2.new(1, -28, 0, 5), 99)
        MakeHandle("ResizeBottom", Vector2.new(0, 1), UDim2.new(0, 14, 1, 0), UDim2.new(1, -28, 0, 5), 99)
        MakeHandle("ResizeTopLeft", Vector2.new(0, 0), UDim2.new(0, 0, 0, 0), UDim2.fromOffset(16, 16), 100)
        MakeHandle("ResizeTopRight", Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.fromOffset(16, 16), 100)
        MakeHandle("ResizeBottomLeft", Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.fromOffset(16, 16), 100)
        MakeHandle("ResizeBottomRight", Vector2.new(1, 1), UDim2.new(1, 0, 1, 0), UDim2.fromOffset(16, 16), 100)

        Connect(UIS.InputChanged, function(i)
            if not pointer or not edge then return end
            local mouse = pointer.UserInputType == Enum.UserInputType.MouseButton1
                and i.UserInputType == Enum.UserInputType.MouseMovement
            if not mouse and i ~= pointer then return end
            local delta = (i.Position - startPointer) / startScale
            local left = edge:find("Left", 1, true) ~= nil
            local right = edge:find("Right", 1, true) ~= nil
            local top = edge:find("Top", 1, true) ~= nil
            local bottom = edge:find("Bottom", 1, true) ~= nil
            local width = startSize.X
            local height = startSize.Y
            if left or right then
                width = math.clamp(startSize.X + (left and -delta.X or delta.X), 620, 1000)
            end
            if top or bottom then
                height = math.clamp(startSize.Y + (top and -delta.Y or delta.Y), 360, 760)
            end
            local dx = left and (startSize.X - width) * startScale or 0
            local dy = top and (startSize.Y - height) * startScale or 0
            Frame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + dx,
                startPosition.Y.Scale,
                startPosition.Y.Offset + dy
            )
            Frame.Size = UDim2.fromOffset(width, height)
        end)

