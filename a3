    local function ResolveBackgroundAsset(url)
        url = tostring(url or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if url == "" then return nil, "Enter an image URL first" end
        if url:match("^%d+$") then return "rbxassetid://" .. url end
        if url:match("^rbxassetid://%d+$") then return url end
        local robloxId = url:match("roblox%.com/asset/%?id=(%d+)")
            or url:match("roblox%.com/asset%?.-id=(%d+)")
        if robloxId then return "rbxassetid://" .. robloxId end
        if not url:match("^https://") then
            return nil, "Use an HTTPS image link or a Roblox asset ID"
        end

        local requestFn
        if type(syn) == "table" and type(syn.request) == "function" then
            requestFn = syn.request
        elseif type(http_request) == "function" then
            requestFn = http_request
        elseif type(request) == "function" then
            requestFn = request
        end
        if type(writefile) ~= "function" then
            return nil, "This executor cannot save URL images"
        end
        local body
        local contentType = ""
        if type(requestFn) == "function" then
            local ok, response = pcall(requestFn, {
                Url = url,
                Method = "GET",
                Headers = { ["Accept"] = "image/*" },
            })
            if not ok or type(response) ~= "table" then
                return nil, "Image download failed"
            end
            local statusCode = tonumber(response.StatusCode or response.Status or 200)
            if statusCode and (statusCode < 200 or statusCode >= 300) then
                return nil, "Image server returned HTTP " .. tostring(statusCode)
            end
            body = response.Body or response.body
            local headers = response.Headers or response.headers
            if type(headers) == "table" then
                for key, value in pairs(headers) do
                    if tostring(key):lower() == "content-type" then
                        contentType = tostring(value):lower()
                        break
                    end
                end
            end
        else
            local ok, result = pcall(function() return game:HttpGet(url) end)
            if not ok then return nil, "Image download failed" end
            body = result
        end
        if type(body) ~= "string" or #body == 0 then
            return nil, "The URL did not return image data"
        end
        if #body > 12582912 then return nil, "Image is too large (12 MB limit)" end
        if contentType ~= "" and not contentType:find("image/", 1, true) then
            return nil, "The link did not return an image"
        end
        local extension = contentType:find("jpeg", 1, true) and ".jpg"
            or contentType:find("webp", 1, true) and ".webp"
            or ".png"
        if not EnsureFolder(ConfigFolder) then return nil, "Could not create the Skido folder" end
        local path = ConfigFolder .. "/custom_background" .. extension
        local wrote = pcall(writefile, path, body)
        if not wrote then return nil, "Could not save the downloaded image" end

        local getAsset = type(getcustomasset) == "function" and getcustomasset
            or type(getsynasset) == "function" and getsynasset
        if type(getAsset) ~= "function" then
            return nil, "This executor cannot load local image assets"
        end
        local assetOk, asset = pcall(getAsset, path)
        if not assetOk or type(asset) ~= "string" or asset == "" then
            return nil, "The executor could not load the downloaded image"
        end
        return asset
    end

    local function SetBackgroundImage(url)
        local asset, err = ResolveBackgroundAsset(url)
        if not asset then return false, err end
        local ok = pcall(function()
            BackgroundImage.Image = asset
            BackgroundImage.Visible = true
            Frame.BackgroundTransparency = 0.34
            Header.BackgroundTransparency = 0.3
            Dash.BackgroundTransparency = 0.38
            Pages.BackgroundTransparency = 0.38
            for _, object in ipairs(Gui:GetDescendants()) do
                if object.Name:match("^GroupBox_") then
                    object.BackgroundTransparency = 0.35
                elseif object.Name == "Header" and object.Parent and object.Parent.Name:match("^GroupBox_") then
                    object.BackgroundTransparency = 0.55
                end
            end
        end)
        if not ok then return false, "Could not apply the background image" end
        CurrentBackgroundUrl = tostring(url)
        return true, "Background applied"
    end

