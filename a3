                    local yes = multi and selections[v] or selected == v
                    btn.BackgroundColor3 = yes and Theme.AccentMuted or Theme.ControlBg
                    btn.TextColor3 = yes and Theme.Accent or Theme.TextPrimary
                end

                local function get()
                    if not multi then return selected end
                    local r = {}
                    for _, v in ipairs(values) do
                        if selections[v] then r[v] = true end
                    end
                    return r
                end

                local function refreshVisuals()
                    local names = {}
                    for _, v in ipairs(values) do
                        if multi and selections[v] then
                            table.insert(names, tostring(v))
                        end
                        if optionButtons[v] then
                            visual(optionButtons[v], v)
                        end
                    end
                    if multi then
                        T.Text = #names > 0 and table.concat(names, ", ") or tostring(name or "")
                    else
                        T.Text = selected ~= nil and tostring(selected) or tostring(name or "")
                    end
                end

                local function set(v, fire)
                    if multi then
                        selections = {}
                        for _, x in ipairs(values) do
                            if type(v) == "table" then
                                if v[x] == true or v[tostring(x)] == true or table.find(v, x) then
                                    selections[x] = true
                                end
                            elseif v ~= nil and v ~= false and tostring(x) == tostring(v) then
                                selections[x] = true
                            end
                        end
                    else
                        selected = nil
                        if v ~= nil and v ~= false then
                            for _, x in ipairs(values) do
                                if x == v or tostring(x) == tostring(v) then
                                    selected = x
                                    break
                                end
                            end
                        end
                    end
                    refreshVisuals()
                    if fire then pcall(callback, get()) end
                end

