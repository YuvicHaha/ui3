                        SB.TextSize=9
                        SB.TextWrapped=true
                        SB.BackgroundColor3=Color3.fromRGB(30,30,30)
                        SB.TextColor3=Color3.fromRGB(160,160,160)

                        SC.CornerRadius=UDim.new(0,5)
                        SC.Parent=SB

                        SB.MouseButton1Click:Connect(function()
                            enabled=not enabled
                            SB.BackgroundColor3=enabled and Color3.fromRGB(40,140,70) or Color3.fromRGB(30,30,30)
                            SB.TextColor3=Color3.new(1,1,1)
                            Update()
                        end)
                    end
                end)
            elseif hasBind then
                local listening=false

                Bind.MouseButton1Click:Connect(function()
                    Bind.Text="..."
                    listening=true
                end)

                UIS.InputBegan:Connect(function(i,gp)
                    if listening then
                        if i.UserInputType==Enum.UserInputType.Keyboard or i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.MouseButton2 or i.UserInputType==Enum.UserInputType.MouseButton3 then
                            if i.KeyCode==Enum.KeyCode.Escape or i.KeyCode==Enum.KeyCode.Backspace then
                                currentBind=nil
                                Bind.Text="None"
                            elseif i.UserInputType==Enum.UserInputType.Keyboard then
                                currentBind=i.KeyCode
                                Bind.Text=i.KeyCode.Name
                            else
                                currentBind=i.UserInputType
                                Bind.Text=i.UserInputType.Name:gsub("MouseButton","MB")
                            end

                            listening=false
                        end
                    elseif not gp and currentBind then
                        local match=(currentBind.EnumType==Enum.KeyCode and i.KeyCode==currentBind) or (currentBind.EnumType==Enum.UserInputType and i.UserInputType==currentBind)

                        if match then
                            enabled=not enabled
                            Update()
                        end
                    end
                end)
            end

            pcall(callback,enabled)
            RegisterElement(H,name,"Toggle")
        end

        --// SLIDER
        function Elements:addSlider(name,minvalue,maxvalue,callback)
            local min=tonumber(minvalue) or 0
            local max=tonumber(maxvalue) or 100

            local H=Instance.new("Frame")
            local C=Instance.new("UICorner")
            local T=Instance.new("TextLabel")
            local B=Instance.new("TextButton")
            local BC=Instance.new("UICorner")
            local Trail=Instance.new("Frame")
            local TC=Instance.new("UICorner")
            local Num=Instance.new("TextBox")

            H.Parent=Home
            H.BackgroundColor3=Color3.fromRGB(17,17,17)
            H.BorderSizePixel=0
            H.Size=UDim2.new(0,304,0,30)

            C.CornerRadius=UDim.new(0,5)
            C.Parent=H

            T.Parent=H
            T.BackgroundTransparency=1
            T.Position=UDim2.new(.024,0,0,3)
            T.Size=UDim2.new(0,240,0,10)
            T.Font=Enum.Font.GothamSemibold
            T.Text=name or ""
            T.TextColor3=Color3.new(1,1,1)
            T.TextSize=11
            T.TextXAlignment=Enum.TextXAlignment.Left

            Num.Parent=H
            Num.BackgroundTransparency=1
            Num.Position=UDim2.new(.84,0,0,2)
            Num.Size=UDim2.new(0,42,0,13)
            Num.Font=Enum.Font.GothamSemibold
            Num.Text=tostring(min)
            Num.TextColor3=Color3.new(1,1,1)
            Num.TextSize=10
            Num.TextXAlignment=Enum.TextXAlignment.Right
            Num.ClearTextOnFocus=false

            B.Parent=H
            B.BackgroundColor3=Color3.fromRGB(5,5,5)
            B.BorderSizePixel=0
            B.Position=UDim2.new(0,8,0,19)
            B.Size=UDim2.new(1,-16,0,7)
            B.Text=""
            B.AutoButtonColor=false

            BC.CornerRadius=UDim.new(0,4)
            BC.Parent=B

            Trail.Parent=B
            Trail.BackgroundColor3=Color3.fromRGB(40,40,40)
            Trail.Size=UDim2.new(0,1,1,0)

            TC.CornerRadius=UDim.new(0,4)
            TC.Parent=Trail

            local function Set(v)
                v=math.clamp(tonumber(v) or min,min,max)

                Num.Text=tostring(math.floor(v))

                local p=max==min and 0 or (v-min)/(max-min)

                Trail.Size=UDim2.new(p,0,1,0)

                pcall(callback,v)

                task.defer(UpdateCanvas)
            end

            local moving=false

            B.MouseButton1Down:Connect(function()
                moving=true

                local function Update(x)
                    local p=math.clamp((x-B.AbsolutePosition.X)/B.AbsoluteSize.X,0,1)
                    Set(min+(max-min)*p)
                end

                Update(Players.LocalPlayer:GetMouse().X)
            end)

            UIS.InputChanged:Connect(function(i)
                if moving and i.UserInputType==Enum.UserInputType.MouseMovement then
                    local p=math.clamp((i.Position.X-B.AbsolutePosition.X)/B.AbsoluteSize.X,0,1)
                    Set(min+(max-min)*p)
                end
            end)

            UIS.InputEnded:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 then
                    moving=false
                end
            end)

            Num.FocusLost:Connect(function()
                Set(Num.Text)
            end)

            Set(min)

            RegisterElement(H,name,"Slider")
        end

