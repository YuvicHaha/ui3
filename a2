        RefreshAllThemeVisuals()
        if not silent then
            SetBgStatus("Image cleared", "neutral")
        end
        if PersistThemeSettings then PersistThemeSettings() end
    end

    local BgLoadToken = 0
    local function ApplyBackgroundImage(rawInput, silent)
        local url = tostring(rawInput or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if url == "" then
            ClearBackgroundImage(silent)
            return false
        end

        BgLoadToken += 1
        local token = BgLoadToken

        -- Support plain numeric Roblox asset IDs or rbxassetid:// links
        local directId = url:match("^rbxassetid://(%d+)$") or url:match("^(%d+)$")
        if directId then
            CustomBgUrl = "rbxassetid://" .. directId
            BgImage.Image = CustomBgUrl
            CustomBgActive = true
            RefreshAllThemeVisuals()
            if not silent then
                SetBgStatus("Applied asset ID: " .. directId, "good")
            end
            if PersistThemeSettings then PersistThemeSettings() end
            return true
        end

        if not url:match("^https?://") then
            if not silent then
                SetBgStatus("Invalid URL (use https:// or rbxassetid://)", "bad")
            end
            return false
        end

        local assetGetter = (type(getcustomasset) == "function" and getcustomasset)
            or (type(getsynasset) == "function" and getsynasset)
            or nil

        if not assetGetter or type(writefile) ~= "function" then
            if not silent then
                SetBgStatus("Executor missing getcustomasset/writefile", "bad")
            end
            return false
        end

        if not silent then
            SetBgStatus("Downloading image...", "neutral")
        end

        task.spawn(function()
            if not SetupThemeFolder() then
                if alive and token == BgLoadToken and not silent then
                    SetBgStatus("Failed to create theme folder", "bad")
                end
                return
            end

            local ok, body = HttpFetchBinary(url)
            if not alive or token ~= BgLoadToken then return end
            if not ok or type(body) ~= "string" or #body < 64 then
                if not silent then
                    SetBgStatus("Download failed or empty response", "bad")
                end
                return
            end

            local head = body:sub(1, 64):lower()
            if head:find("<!doctype", 1, true) or head:find("<html", 1, true) then
                if not silent then
                    SetBgStatus("Link returned webpage, not direct image", "bad")
                end
                return
            end

            local cleanPathOnly = url:match("^([^?#]+)") or url
            local ext = cleanPathOnly:lower():match("%.([a-z0-9]+)$")
            if ext ~= "png" and ext ~= "jpg" and ext ~= "jpeg" and ext ~= "webp" then
                ext = "png"
            end

            local filePath = ThemeFolder .. "/bg_" .. HashString(url) .. "." .. ext
            local wroteOk = pcall(writefile, filePath, body)
            if not wroteOk then
                if not silent then
                    SetBgStatus("Failed to write cached image", "bad")
                end
                return
            end

            local assetOk, assetUri = pcall(assetGetter, filePath)
            if not alive or token ~= BgLoadToken then return end
            if not assetOk or type(assetUri) ~= "string" or assetUri == "" then
                if not silent then
                    SetBgStatus("Failed to load custom asset", "bad")
                end
                return
            end

            CustomBgUrl = url
            BgImage.Image = assetUri
            CustomBgActive = true
            RefreshAllThemeVisuals()
            if not silent then
                SetBgStatus("Custom image applied", "good")
            end
            if PersistThemeSettings then PersistThemeSettings() end
        end)

        return true
    end

