            local ok, contents = pcall(function() return readfile(themePath) end)
            if ok and contents then
                local decodedOk, tData = pcall(function() return HttpService:JSONDecode(contents) end)
                if decodedOk and type(tData) == "table" then
                    if type(tData.Preset) == "string" and ThemePresets[tData.Preset] then
                        ApplyThemePreset(tData.Preset)
                        if ThemePresetDropdown then ThemePresetDropdown.Set(tData.Preset) end
                    end
                    local savedAccent = TableToColor(tData.Accent)
                    local savedSecondary = TableToColor(tData.AccentSecondary)
                    if savedAccent or savedSecondary then
                        SetCustomAccentColors(savedAccent, savedSecondary)
                        if PrimaryAccentPicker and savedAccent then PrimaryAccentPicker.Set(savedAccent) end
                        if SecondaryAccentPicker and savedSecondary then SecondaryAccentPicker.Set(savedSecondary) end
                    end
                    if type(tData.WindowTransparency) == "number" then
                        WindowTransparency = math.clamp(tData.WindowTransparency, 0, 0.85)
                    end
                    if type(tData.PanelTransparency) == "number" then
                        PanelTransparency = math.clamp(tData.PanelTransparency, 0, 0.85)
                    end
                    if type(tData.BgTransparency) == "number" then
                        CustomBgTransparency = math.clamp(tData.BgTransparency, 0, 0.9)
                    end
                    if type(tData.BgScaleMode) == "string" and ScaleModeMap[tData.BgScaleMode] then
                        CustomBgScaleMode = ScaleModeMap[tData.BgScaleMode]
                        if BgScaleDropdown then BgScaleDropdown.Set(tData.BgScaleMode) end
                    end
                    RefreshAllThemeVisuals()
                    if type(tData.BgUrl) == "string" and tData.BgUrl ~= "" then
                        if BgUrlInputBox then BgUrlInputBox.Text = tData.BgUrl end
                        ApplyBackgroundImage(tData.BgUrl, true)
                    end
                end
            end
        end
        ThemeReady = true

        local settingsPath = ConfigFolder .. "/settings.json"
        if FileExists(settingsPath) then
            local ok, contents = pcall(function() return readfile(settingsPath) end)
            if ok and contents then
                local decodedOk, data = pcall(function() return HttpService:JSONDecode(contents) end)
                if decodedOk and type(data) == "table" then
                    if type(data.Config) == "string" and data.Config ~= "" then
                        CurrentConfig = CleanName(data.Config)
                    end
                    AutoLoad = data.AutoLoad == true
                    if ConfigNameBox then ConfigNameBox.Text = CurrentConfig end
                end
            end
        end
        if AutoLoadSetter then pcall(AutoLoadSetter, AutoLoad) end
        SettingsReady = true
        task.wait(0.15)
        if not alive then return end
        if ConfigDropdown then ConfigDropdown.Refresh(GetConfigFiles()) end
        if PluginDropdown then RefreshPluginDropdown() end
        if AutoLoad then
            task.wait(0.25)
            if not alive then return end
            LoadConfig(CurrentConfig)
        end
    end)

    task.defer(function()
        task.wait(0.05)
        if not alive then return end
        UpdateTogglePanel()
        UpdateWindowLayout()
        HomePage.__Show()
    end)

    PageYep.AddPage = PageYep.addPage
    PageYep.HomePage = HomePage
    PageYep.ThemesPage = ThemesPage
    PageYep.ConfigPage = ConfigPage
    PageYep.Destroy = function() Gui:Destroy() end
    PageYep.SaveConfig = function(_, name) return SaveConfig(name or CurrentConfig) end
    PageYep.LoadConfig = function(_, name) return LoadConfig(name or CurrentConfig) end
    PageYep.SetTheme = function(_, name) return ApplyThemePreset(name) end
    PageYep.SetBackgroundImage = function(_, url) return ApplyBackgroundImage(url, false) end
    PageYep.ClearBackgroundImage = function() ClearBackgroundImage(false) end
    PageYep.Reset = ResetAll
    PageYep.LoadPlugin = function(_, path) return LoadPlugin(path) end
    return PageYep
end

return Library
