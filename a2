    local function SaveConfig(name)
        if not SetupFolder() then
            SetStatus("Filesystem unavailable", false)
            return false
        end
        name = CleanName(name)
        local lowerName = name:lower()
        if lowerName == "settings" or lowerName == "theme" then
            SetStatus("Reserved config name", false)
            return false
        end
        local data = {
            Version = 6,
            ConfigName = name,
            Values = {},
            Plugins = LoadedConfigData and type(LoadedConfigData.Plugins) == "table"
                and Clone(LoadedConfigData.Plugins) or {}
        }
        for _, entry in ipairs(ConfigEntries) do
            local ok, value = pcall(entry.Get)
            if ok then
                if typeof(value) == "Color3" then value = ColorToTable(value) end
                data.Values[entry.Key] = { Type = entry.Type, Value = value }
            end
        end
        for _, entry in ipairs(PluginConfigEntries) do
            if entry.Plugin then
                local pluginName = entry.Plugin.File
                data.Plugins[pluginName] = data.Plugins[pluginName]
                    or { File = entry.Plugin.File, Values = {} }
                local ok, value = pcall(entry.Get)
                if ok then
                    if typeof(value) == "Color3" then value = ColorToTable(value) end
                    data.Plugins[pluginName].Values[entry.Key] = { Type = entry.Type, Value = value }
                end
            end
        end
        local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then
            SetStatus("Failed to encode config", false)
            return false
        end
        local success = pcall(function() writefile(ConfigPath(name), json) end)
        if not success then
            SetStatus("Failed to save", false)
            return false
        end
        CurrentConfig = name
        if ConfigNameBox then ConfigNameBox.Text = name end
        PersistSettings()
        SetStatus("Saved: " .. name, true)
        return true
    end

    local function LoadConfig(name)
        if not SetupFolder() then
            SetStatus("Filesystem unavailable", false)
            return false
        end
        name = CleanName(name)
        local path = ConfigPath(name)
        local lowerName = name:lower()
        if lowerName == "settings" or lowerName == "theme" then
            SetStatus("Reserved config name", false)
            return false
        end
        if not FileExists(path) then
            SetStatus("Not found: " .. name, false)
            return false
        end
        local ok, contents = pcall(function() return readfile(path) end)
        if not ok or not contents then
            SetStatus("Failed to read", false)
            return false
        end
        local decodedOk, data = pcall(function() return HttpService:JSONDecode(contents) end)
        if not decodedOk or type(data) ~= "table" or type(data.Values) ~= "table" then
            SetStatus("Invalid config", false)
            return false
        end
        LoadedConfigData = data
        local failures = 0
        local function apply(entries, values)
            for _, entry in ipairs(entries) do
                local saved = values[entry.Key] or values[entry.Name]
                if saved ~= nil then
                    local valid = type(saved) == "table"
                        and (saved.Type == nil or saved.Type == entry.Type)
                        and saved.Value ~= nil
                    if valid and entry.Type == "Slider" then
                        valid = type(saved.Value) == "number"
                            and saved.Value == saved.Value
                            and math.abs(saved.Value) ~= math.huge
                    elseif valid and entry.Type == "Toggle" then
                        valid = type(saved.Value) == "table" or type(saved.Value) == "boolean"
                    elseif valid and (entry.Type == "Color3" or entry.Type == "ColorPicker") then
                        local v = saved.Value
                        valid = typeof(v) == "Color3"
                            or (type(v) == "table" and type(v.R) == "number"
                                and type(v.G) == "number" and type(v.B) == "number")
                    end
                    if not valid or not pcall(entry.Set, Clone(saved.Value)) then
                        failures += 1
                    end
                end
            end
        end
        apply(ConfigEntries, data.Values)
        if type(data.Plugins) == "table" then
            for _, entry in ipairs(PluginConfigEntries) do
                local pluginData = data.Plugins[entry.Plugin.File] or data.Plugins[entry.Plugin.Name]
                if type(pluginData) == "table" and type(pluginData.Values) == "table" then
                    apply({ entry }, pluginData.Values)
                end
            end
        end
        if failures > 0 then
            SetStatus("Partially loaded (" .. failures .. " failed)", false)
            return false
        end
        CurrentConfig = name
        if ConfigNameBox then ConfigNameBox.Text = name end
        PersistSettings()
        SetStatus("Loaded: " .. name, true)
        return true
    end

