    local function Clone(value)
        if type(value) ~= "table" then return value end
        local copy = {}
        for key, item in pairs(value) do
            copy[key] = Clone(item)
        end
        return copy
    end

    local function RegisterWindowConfig(name, typ, getter, setter, pageName, plugin, groupName)
        if pageName == "Config" and name == "Auto Load" then
            AutoLoadSetter = setter
            return
        end
        if pageName == "Config" and name == "" then return end
        local scopeId = groupName and (pageName .. "::" .. groupName) or pageName
        local base = HttpService:JSONEncode({ scopeId, typ, tostring(name or "") })
        local scope = plugin and plugin.File or "main"
        local counterKey = scope .. "|" .. base
        ConfigKeyCounts[counterKey] = (ConfigKeyCounts[counterKey] or 0) + 1
        local key = base .. "#" .. ConfigKeyCounts[counterKey]
        local _, defaultValue = pcall(getter)
        local entry = {
            Name = tostring(name or ""),
            Key = key,
            Type = typ,
            Get = getter,
            Set = setter,
            Default = Clone(defaultValue),
            Plugin = plugin
        }
        table.insert(ResetEntries, entry)
        if plugin then
            table.insert(PluginConfigEntries, entry)
        else
            table.insert(ConfigEntries, entry)
        end

        if LoadedConfigData then
            local values = nil
            if plugin then
                local plugins = LoadedConfigData.Plugins
                local pluginData = type(plugins) == "table"
                    and (plugins[plugin.File] or plugins[plugin.Name])
                if type(pluginData) == "table" then
                    values = pluginData.Values
                end
            else
                values = LoadedConfigData.Values
            end
            if type(values) == "table" then
                local saved = values[key] or values[entry.Name]
                if type(saved) == "table"
                    and (saved.Type == nil or saved.Type == typ)
                    and saved.Value ~= nil then
                    pcall(setter, Clone(saved.Value))
                end
            end
        end
    end

    local function Search(query)
        SearchToken += 1
        local token = SearchToken
        query = tostring(query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then
            ClearHighlight()
            return
        end
        for _, data in ipairs(AllElements) do
            if data.Object and data.Object.Parent and data.Page and data.Page.Parent
                and data.Name:lower():find(query, 1, true) then
                local page = data.Page
                for _, p in ipairs(Folder:GetChildren()) do
                    if p:IsA("ScrollingFrame") then p.Visible = false end
                end
                page.Visible = true
                SetActiveTabVisual(page.Name)

                task.defer(function()
                    task.wait()
                    if not alive or token ~= SearchToken then return end
                    if not data.Object or not data.Object.Parent then return end
                    local y = data.Object.AbsolutePosition.Y
                        - page.AbsolutePosition.Y
                        + page.CanvasPosition.Y
                        - 16
                    local maxY = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteSize.Y)
                    page.CanvasPosition = Vector2.new(0, math.clamp(y, 0, maxY))
                    ClearHighlight()
                    HighlightToken += 1
                    local ht = HighlightToken
                    HighlightedObject = data.Object
                    HighlightedColor = data.Object.BackgroundColor3
                    data.Object.BackgroundColor3 = Theme.AccentMuted
                    task.delay(0.65, function()
                        if ht ~= HighlightToken then return end
                        if HighlightedObject == data.Object
                            and HighlightedObject.Parent
                            and HighlightedColor then
                            HighlightedObject.BackgroundColor3 = HighlightedColor
                        end
                        HighlightedObject = nil
                        HighlightedColor = nil
                    end)
                end)
                return
            end
        end
        ClearHighlight()
    end

