                    if multi then
                        selections = {}
                        for _, x in ipairs(values) do
                            if type(v) == "table" then
                                if v[x] == true or v[tostring(x)] == true or table.find(v, x) then
                                    selections[x] = true
                                end
                            elseif v ~= nil and v ~= false and tostring(x) == tostring(v) then
                                selections[x] = true
                            end
                        end
                    else
                        selected = nil
                        if v ~= nil and v ~= false then
                            for _, x in ipairs(values) do
                                if x == v or tostring(x) == tostring(v) then
                                    selected = x
                                    break
                                end
                            end
                        end
                    end
                    refreshVisuals()
                    if fire then pcall(callback, get()) end
                end

                B.MouseButton1Click:Connect(function()
                    open = not open
                    Panel.Visible = open
                    SetRowHeight(H, open and 142 or 28, isInsideGroup)
                    Icon.ImageColor3 = open and Theme.Accent or Theme.TextSecondary
                    task.defer(UpdateCanvas)
                end)

                local function build(valuesList)
                    values = {}
                    optionButtons = {}
                    local seen = {}
                    for _, ch in ipairs(Scroll:GetChildren()) do
                        if ch:IsA("TextButton") then ch:Destroy() end
                    end
                    for _, v in ipairs(type(valuesList) == "table" and valuesList or {}) do
                        if not seen[v] then
