                            v = v.Values
                        end
                        set(v, true)
                    end
                )
                task.defer(UpdateCanvas)
                return {
                    Object = H,
                    Refresh = function(newList) build(newList or {}) end,
                    Get = function() return get() end,
                    Set = function(v) set(v, true) end
