task.spawn(function()
    print("[WATCHDOG] STARTED")
    while true do
        task.wait(5)
        
        if lastBalance ~= nil then
            local timeSinceLastChange = os.time() - lastBalanceChangeTime
            if timeSinceLastChange >= tonumber(getgenv().STAGNANT_TREASURY_EMERGENCY_THRESHOLD) then
                if os.time() - lastStagnantNotificationTime >= tonumber(getgenv().TREASURY_CRISIS_BROADCAST_COOLDOWN) then
                    local currentStrBal, currentRawBal, _, _, isSuccess = GetCurrentBalanceSafe()
                    if isSuccess and currentRawBal ~= nil then
                        print("[WATCHDOG] Balance unchanged:", timeSinceLastChange, "seconds")
                        if BroadcastStagnantAlert(currentStrBal, currentRawBal, timeSinceLastChange) then
                            lastStagnantNotificationTime = os.time()
                            hasStagnated = true
                        end
                    end
                end
            end
        end
        
        if CanSaveFiles() then
            local heartbeatData = LoadJSON(HEARTBEAT_FILE)
            if heartbeatData and heartbeatData.timestamp then
                local lastHeartbeatTime = tonumber(heartbeatData.timestamp)
                if lastHeartbeatTime then
                    local timeSinceHeartbeat = os.time() - lastHeartbeatTime
                    if timeSinceHeartbeat >= tonumber(getgenv().APOCALYPTIC_PULSE_FATAL_TIMEOUT) then
                        if os.time() - lastHeartbeatNotificationTime >= tonumber(getgenv().SYSTEM_FLATLINE_BROADCAST_COOLDOWN) then
                            print("[WATCHDOG] HEARTBEAT LOST:", timeSinceHeartbeat, "seconds")
                            if BroadcastHeartbeatLost(timeSinceHeartbeat) then
                                lastHeartbeatNotificationTime = os.time()
                                hasLostHeartbeat = true
                            end
                        end
                    elseif hasLostHeartbeat then
                        DispatchWebhook("🟢 Tracker Heartbeat Recovered", "The tracker is updating normally again.", 3066993, {
                            { name = "🎮 Game", value = GameName, inline = true },
                            { name = "❤️ Heartbeat Age", value = tostring(timeSinceHeartbeat) .. " seconds", inline = true }
                        })
                        hasLostHeartbeat = false
                    end
                end
            end
        end
        
        UpdateStatusFile()
    end
end)

