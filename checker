local function MakeSignature(raw, sec, bank)
    return tostring(raw or 0) .. "|" .. tostring(sec or 0) .. "|" .. tostring(bank or 0)
end

task.spawn(function()
    print("==========================================")
    print("[TRACKER] STARTED | Game:", GameName, "| PlaceId:", PlaceId)
    print("==========================================")

    local strBal, rawBal, strSec, rawSec, success, strBank, rawBank = GetCurrentBalanceSafe()
    if not success then
        warn("[TRACKER] Currency UI/data was not found. Waiting for it...")
    else
        print("[TRACKER] Cash:", tostring(strBal))
        if GameName == "The Bronx 3" then
            print("[TRACKER] Illegal:", tostring(strSec))
            print("[TRACKER] Bank:", tostring(strBank or "not found"))
        end
        BroadcastBalanceUpdate(strBal, strSec, strBank, nil, "Tracker started")
    end

    while true do
        local delayTime = tonumber(getgenv().TEMPORAL_INSPECTION_CYCLE_DELAY) or 5
        local curStr, curRaw, curStrSec, curRawSec, ok, curStrBank, curRawBank = GetCurrentBalanceSafe()

        if ok and curRaw ~= nil then
            local signature = MakeSignature(curRaw, curRawSec, curRawBank)

            if lastSignature == nil then
                lastSignature = signature
                lastBalance = curRaw
                lastBalanceChangeTime = os.time()
            elseif signature ~= lastSignature then
                local delta = curRaw - (lastBalance or curRaw)
                print("[TRACKER] Cash:", FormatNumberWithCommas(lastBalance), "->", FormatNumberWithCommas(curRaw))

                lastSignature = signature
                lastBalance = curRaw
                lastBalanceChangeTime = os.time()
                hasStagnated = false

                if not getgenv().RESTRICT_DISPATCH_TO_TREASURY_SHIFTS_ONLY then
                    BroadcastBalanceUpdate(curStr, curStrSec, curStrBank, delta)
                end
            end

            latest = { strBal = curStr, rawBal = curRaw, strSec = curStrSec, rawSec = curRawSec, rawBank = curRawBank }
            UpdateStatusFile()
            task.wait(delayTime)
        else
            warn("[TRACKER] Currency source unavailable. Retrying...")
            UpdateStatusFile()
            task.wait(5)
        end
    end
end)

