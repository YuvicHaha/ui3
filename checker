local function FormatNumberWithCommas(amount)
    local formatted = tostring(math.floor(tonumber(amount) or 0))
    while true do  
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function ParseCurrencyString(str)
    if not str then return 0 end
    local cleanStr = string.gsub(tostring(str), "[$,%s]", "")
    local num = tonumber(string.match(cleanStr, "^%d+%.?%d*")) or 0
    local suffix = string.match(cleanStr, "%a+$")
    
    if suffix then
        suffix = string.lower(suffix)
        if suffix == "k" then num = num * 1e3
        elseif suffix == "m" then num = num * 1e6
        elseif suffix == "b" then num = num * 1e9
        elseif suffix == "t" then num = num * 1e12
        end
    end
    return num
end

local function CanSaveFiles()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function SaveJSON(filename, dataTable)
    if not CanSaveFiles() then return false end
    return pcall(function()
        writefile(filename, HttpService:JSONEncode(dataTable))
    end)
end

local function LoadJSON(filename)
    if not CanSaveFiles() then return nil end
    local success, result = pcall(function()
        if type(isfile) == "function" and not isfile(filename) then return nil end
        local content = readfile(filename)
        if not content or content == "" then return nil end
        return HttpService:JSONDecode(content)
    end)
    return success and result or nil
end

