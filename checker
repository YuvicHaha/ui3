local COLOR_INFO = 3092790   -- neutral dark
local COLOR_WARN = 16705372  -- soft yellow
local COLOR_BAD  = 15548997  -- red

local SecondaryLabels = {
    ["Bloxburg"] = "Blockbux",
    ["The Bronx 3"] = "Illegal",
}

local function FormatDuration(seconds)
    seconds = math.floor(tonumber(seconds) or 0)
    if seconds >= 3600 then
        return string.format("%dh %dm", seconds // 3600, (seconds % 3600) // 60)
    elseif seconds >= 60 then
        return string.format("%dm", seconds // 60)
    end
    return seconds .. "s"
end

local function DispatchWebhook(title, description, color, fields)
    local webhookUrl = getgenv().INTERGALACTIC_DISCORD_TRANSMISSION_ENDPOINT
    if not webhookUrl or webhookUrl == "" then
        warn("[WEBHOOK] URL not configured.")
        return false
    end

    local requestFunc = GetHttpRequestFunc()
    if not requestFunc then
        warn("[WEBHOOK] HTTP request unsupported by your executor.")
        return false
    end

    local embed = {
        title = title,
        color = color or COLOR_INFO,
        footer = { text = LocalPlayer.Name .. "  ·  " .. GameName },
        timestamp = DateTime.now():ToIsoDate()
    }
    if description and description ~= "" then embed.description = description end
    if fields and #fields > 0 then embed.fields = fields end

    local success = pcall(function()
        return requestFunc({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ username = "Tracker", embeds = { embed } })
        })
    end)

    if not success then
        warn("[WEBHOOK] Failed to send payload.")
        return false
    end
    return true
end

local function BuildBalanceFields(strBal, strSec, strBank, delta)
    local cashText = tostring(strBal)
    if delta and delta ~= 0 then
        cashText = cashText .. string.format(" (%s%s)", delta > 0 and "+" or "-", FormatNumberWithCommas(math.abs(delta)))
    end

    local fields = { { name = "Cash", value = cashText, inline = true } }

    if strSec ~= nil then
        table.insert(fields, { name = SecondaryLabels[GameName] or "Secondary", value = tostring(strSec), inline = true })
    end
    if GameName == "The Bronx 3" then
        table.insert(fields, { name = "Bank", value = strBank and tostring(strBank) or "not found", inline = true })
    end
    return fields
end

local function BroadcastBalanceUpdate(strBal, strSec, strBank, delta, title)
    return DispatchWebhook(title or "Balance", nil, COLOR_INFO, BuildBalanceFields(strBal, strSec, strBank, delta))
end

local function BroadcastStagnantAlert(strBal, seconds)
    return DispatchWebhook("Balance unchanged", "No change for " .. FormatDuration(seconds), COLOR_WARN, {
        { name = "Cash", value = tostring(strBal), inline = true }
    })
end

local function BroadcastHeartbeatLost(secondsAgo)
    return DispatchWebhook("Tracker offline", "No heartbeat for " .. FormatDuration(secondsAgo), COLOR_BAD)
end

