local function FormatNumberWithCommas(amount)
    local formatted = tostring(math.floor(tonumber(amount) or 0))
    while true do  
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function ParseCurrencyString(str)
    if not str then return 0 end
    local cleanStr = string.gsub(tostring(str), "[$,%s]", "")
    local num = tonumber(string.match(cleanStr, "^%d+%.?%d*")) or 0
    local suffix = string.match(cleanStr, "%a+$")
    
    if suffix then
        suffix = string.lower(suffix)
        if suffix == "k" then num = num * 1e3
        elseif suffix == "m" then num = num * 1e6
        elseif suffix == "b" then num = num * 1e9
        elseif suffix == "t" then num = num * 1e12
        end
    end
    return num
end

local function CanSaveFiles()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function SaveJSON(filename, dataTable)
    if not CanSaveFiles() then return false end
    return pcall(function()
        writefile(filename, HttpService:JSONEncode(dataTable))
    end)
end

local function LoadJSON(filename)
    if not CanSaveFiles() then return nil end
    local success, result = pcall(function()
        if type(isfile) == "function" and not isfile(filename) then return nil end
        local content = readfile(filename)
        if not content or content == "" then return nil end
        return HttpService:JSONDecode(content)
    end)
    return success and result or nil
end

-- Finds the Bronx bank amount. Tries exact names, then any value with "bank" in its name,
-- then attributes. Result is cached; if nothing is found it prints what exists so the
-- right name can be added.
local BankCache = nil
local BankDumped = false

local function ReadNumeric(inst)
    if inst:IsA("IntValue") or inst:IsA("NumberValue") then
        return tonumber(inst.Value)
    elseif inst:IsA("StringValue") then
        local n = ParseCurrencyString(inst.Value)
        return n > 0 and n or nil
    end
    return nil
end

local function FindBankAmount(Stored)
    if BankCache and BankCache.Parent then
        local v = ReadNumeric(BankCache)
        if v then return v end
    end
    BankCache = nil

    local roots = {}
    for _, r in ipairs({ Stored, LocalPlayer, LocalPlayer:FindFirstChild("leaderstats"), LocalPlayer:FindFirstChild("DataFolder") }) do
        if r then table.insert(roots, r) end
    end

    local exact = { "Bank", "BankMoney", "BankCash", "BankBalance", "Savings", "BankAmount" }
    for _, root in ipairs(roots) do
        for _, name in ipairs(exact) do
            local c = root:FindFirstChild(name, true)
            if c and ReadNumeric(c) ~= nil then
                BankCache = c
                return ReadNumeric(c)
            end
        end
    end

    for _, root in ipairs(roots) do
        for _, d in ipairs(root:GetDescendants()) do
            if string.find(string.lower(d.Name), "bank", 1, true) and ReadNumeric(d) ~= nil then
                BankCache = d
                return ReadNumeric(d)
            end
        end
    end

    for _, root in ipairs(roots) do
        for key, val in pairs(root:GetAttributes()) do
            if string.find(string.lower(key), "bank", 1, true) and tonumber(val) then
                return tonumber(val)
            end
        end
    end

    if not BankDumped then
        BankDumped = true
        warn("[BANK] Not found. Values under stored / DataFolder:")
        for _, root in ipairs({ Stored, LocalPlayer:FindFirstChild("DataFolder") }) do
            if root then
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("ValueBase") then
                        warn("   ", d:GetFullName(), "=", tostring(d.Value))
                    end
                end
            end
        end
    end
    return nil
end

