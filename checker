task.spawn(function()
    print("[WATCHDOG] STARTED")
    while true do
        task.wait(5)

        if lastBalance ~= nil then
            local sinceChange = os.time() - lastBalanceChangeTime
            if sinceChange >= tonumber(getgenv().STAGNANT_TREASURY_EMERGENCY_THRESHOLD) then
                if os.time() - lastStagnantNotificationTime >= tonumber(getgenv().TREASURY_CRISIS_BROADCAST_COOLDOWN) then
                    local curStr, curRaw, _, _, ok = GetCurrentBalanceSafe()
                    if ok and curRaw ~= nil then
                        if BroadcastStagnantAlert(curStr, sinceChange) then
                            lastStagnantNotificationTime = os.time()
                            hasStagnated = true
                        end
                    end
                end
            end
        end

        if CanSaveFiles() then
            local hb = LoadJSON(HEARTBEAT_FILE)
            if hb and hb.timestamp then
                local lastHb = tonumber(hb.timestamp)
                if lastHb then
                    local sinceHb = os.time() - lastHb
                    if sinceHb >= tonumber(getgenv().APOCALYPTIC_PULSE_FATAL_TIMEOUT) then
                        if os.time() - lastHeartbeatNotificationTime >= tonumber(getgenv().SYSTEM_FLATLINE_BROADCAST_COOLDOWN) then
                            if BroadcastHeartbeatLost(sinceHb) then
                                lastHeartbeatNotificationTime = os.time()
                                hasLostHeartbeat = true
                            end
                        end
                    elseif hasLostHeartbeat then
                        DispatchWebhook("Tracker back online", nil, COLOR_INFO)
                        hasLostHeartbeat = false
                    end
                end
            end
        end

        UpdateStatusFile()
    end
end)

