--// DRAG-OUT SHORTCUT SYSTEM
local ShortcutFolder=Instance.new("ScreenGui")
ShortcutFolder.Name="NebulaShortcuts"
ShortcutFolder.ResetOnSpawn=false
ShortcutFolder.IgnoreGuiInset=true
ShortcutFolder.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
ShortcutFolder.Parent=game:GetService("CoreGui")

local ShortcutItems={}
local ShortcutDragTime=.35
local ShortcutDragging=false
local ShortcutInput=nil
local ShortcutGhost=nil

local function RemoveAllShortcuts()
    for i=#ShortcutItems,1,-1 do
        local item=ShortcutItems[i]
        if item and item.Gui then
            item.Gui:Destroy()
        end
        table.remove(ShortcutItems,i)
    end
    ShortcutDragging=false
    ShortcutInput=nil
    ShortcutGhost=nil
end

local function MakeShortcut(source,name,isToggle,callback,getState)
    local gui=Instance.new("TextButton")
    gui.Name="Shortcut_"..tostring(name)
    gui.Size=UDim2.fromOffset(isToggle and 92 or 86,28)
    gui.BackgroundColor3=Color3.fromRGB(28,31,38)
    gui.BorderSizePixel=0
    gui.AutoButtonColor=false
    gui.Text=tostring(name)
    gui.TextSize=12
    gui.Font=Enum.Font.GothamMedium
    gui.TextColor3=Color3.fromRGB(235,238,245)
    gui.ZIndex=1000
    gui.Parent=ShortcutFolder

    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(0,7)
    corner.Parent=gui

    local stroke=Instance.new("UIStroke")
    stroke.Thickness=1
    stroke.Transparency=.35
    stroke.Color=Color3.fromRGB(100,105,120)
    stroke.Parent=gui

    local dragActive=false
    local holdStarted=false
    local moved=false
    local startInputPos=nil
    local startGuiPos=nil
    local holdToken=0

    local function setDragVisual(on)
        if on then
            gui.BackgroundColor3=Color3.fromRGB(55,62,78)
            stroke.Transparency=0
            stroke.Thickness=1.5
        else
            gui.BackgroundColor3=Color3.fromRGB(28,31,38)
            stroke.Transparency=.35
            stroke.Thickness=1
        end
    end

    local function beginDrag(input)
        dragActive=true
        ShortcutDragging=true
        ShortcutInput=input
        startInputPos=input.Position
        startGuiPos=gui.Position
        setDragVisual(true)
        if source and source:IsA("GuiObject") then
            source:SetAttribute("ShortcutDragging",true)
        end
    end

    local function finishDrag()
        if not dragActive then return end
        dragActive=false
        ShortcutDragging=false
        ShortcutInput=nil
        setDragVisual(false)
        if source and source:IsA("GuiObject") then
            source:SetAttribute("ShortcutDragging",false)
        end
    end

    gui.InputBegan:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1
        and input.UserInputType~=Enum.UserInputType.Touch then return end

        holdStarted=true
        moved=false
        startInputPos=input.Position
        holdToken+=1
        local token=holdToken

        task.delay(ShortcutDragTime,function()
            if holdStarted and token==holdToken and not moved then
                beginDrag(input)
            end
        end)
    end)

    gui.InputChanged:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseMovement
        or input.UserInputType==Enum.UserInputType.Touch then
            ShortcutInput=input
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if not dragActive then return end
        if input~=ShortcutInput and input.UserInputType~=Enum.UserInputType.MouseMovement
        and input.UserInputType~=Enum.UserInputType.Touch then return end

        local delta=input.Position-startInputPos
        if delta.Magnitude<2 then return end
        gui.Position=UDim2.new(startGuiPos.X.Scale,startGuiPos.X.Offset+delta.X,startGuiPos.Y.Scale,startGuiPos.Y.Offset+delta.Y)
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1
        and input.UserInputType~=Enum.UserInputType.Touch then return end

        local wasDrag=dragActive
        holdStarted=false
        holdToken+=1
        if wasDrag then
            finishDrag()
        else
            if not moved and callback then
                task.spawn(callback)
            end
        end
    end)

    table.insert(ShortcutItems,{Gui=gui,Source=source})
    return gui
end

