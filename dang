--// ATTACH SHORTCUT HOLD TO GUI ELEMENTS
local function NebulaAttachShortcut(source,name,isToggle,callback,getState)
    if not source or not source:IsA("GuiObject") then return end
    if source:GetAttribute("ShortcutAttached") then return end
    source:SetAttribute("ShortcutAttached",true)

    local UIS=game:GetService("UserInputService")
    local hold=.35
    local down=false
    local dragging=false
    local token=0
    local startPos=nil
    local oldColor=nil

    source.InputBegan:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1
        and input.UserInputType~=Enum.UserInputType.Touch then return end
        down=true
        dragging=false
        startPos=input.Position
        token+=1
        local myToken=token

        task.delay(hold,function()
            if down and token==myToken then
                dragging=true
                source:SetAttribute("ShortcutDragging",true)
                local h=source:FindFirstChildOfClass("UIStroke")
                if h then h.Thickness=1.5 h.Transparency=0 end
            end
        end)
    end)

    UIS.InputChanged:Connect(function(input)
        if not down or not dragging then return end
        if input.UserInputType~=Enum.UserInputType.MouseMovement
        and input.UserInputType~=Enum.UserInputType.Touch then return end
        if (input.Position-startPos).Magnitude<5 then return end

        if not source:GetAttribute("ShortcutCreated") then
            source:SetAttribute("ShortcutCreated",true)
            local shortcut=MakeShortcut(source,name,isToggle,callback,getState)
            shortcut.Position=UDim2.fromOffset(input.Position.X-shortcut.AbsoluteSize.X/2,input.Position.Y-shortcut.AbsoluteSize.Y/2)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1
        and input.UserInputType~=Enum.UserInputType.Touch then return end
        down=false
        token+=1
        if dragging then
            dragging=false
            source:SetAttribute("ShortcutDragging",false)
            local h=source:FindFirstChildOfClass("UIStroke")
            if h then h.Thickness=1 h.Transparency=.35 end
        end
    end)
end
_G.NebulaAttachShortcut=NebulaAttachShortcut

